# Server listening port
PORT=3001

# JSON Web Token secret for signing admin sessions
JWT_SECRET=dckids-super-secret-key-change-in-production

# Firebase Authentication for storefront customers. These four web-app values
# are public identifiers; the server exposes only these fields to the browser.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Admin credentials. Point this at a service-account JSON file stored
# outside the repository, or leave it unset when the host provides Application
# Default Credentials / workload identity. Never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Direct Paystack checkout. Use a test key until webhook routing and payment
# confirmation have been verified. The legacy URL receives every non-DCK event.
PAYSTACK_SECRET_KEY=
PAYSTACK_LEGACY_WEBHOOK_URL=

# Notifications email recipient
SHOP_NOTIFY_EMAIL=info@dckidsbrand.com

# SMTP Server Configurations for transactional emails (e.g. order notifications, password recovery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
